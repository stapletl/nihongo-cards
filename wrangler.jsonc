{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "nihongo-cards",
    "compatibility_date": "2026-08-13",
    // No "main" entry: the site is fully prerendered, so this is an assets-only Worker
    "assets": {
        "directory": "./dist/client",
        // Canonical URLs and the sitemap use the no-trailing-slash form (/hiragana), but
        // the default "auto-trailing-slash" redirects those to /hiragana/ — so every URL
        // we advertise would answer with a redirect. Serve them at the canonical path.
        "html_handling": "drop-trailing-slash",
        // Serves the prerendered 404.html with a 404 status for unmatched paths.
        // Do NOT use "single-page-application" — that returns 200 with the app shell for
        // every unknown URL, which tells crawlers those pages exist.
        "not_found_handling": "404-page"
    },
    // Both hostnames are served by this Worker. www does not serve a duplicate copy of the
    // site — a Cloudflare Redirect Rule ("www to apex") 301s it to the bare domain, and
    // redirect rules run ahead of the Worker, so the route below only ever sees the apex
    // in practice. It still has to exist for the redirect to have something to attach to.
    "routes": [
        { "pattern": "nihongo-cards.com", "custom_domain": true },
        { "pattern": "www.nihongo-cards.com", "custom_domain": true }
    ],
    // Both of these MUST stay declared. `wrangler deploy` applies this file as the Worker's
    // complete desired state, so an unset key is not "leave it alone" — it is "apply the
    // default", and a deploy from main will silently undo whatever the dashboard says.
    //
    // Production is reachable only through the custom domains above. Serving all 210 pages
    // a second time on workers.dev would be a duplicate of the canonical site.
    "workers_dev": false,
    // Defaults to whatever `workers_dev` is, so with the line above it would default to
    // false and break the PR preview job. The preview job needs
    // https://pr-<n>-nihongo-cards.<subdomain>.workers.dev to resolve.
    "preview_urls": true
}
