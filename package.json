{
    "name": "nihongo-cards",
    "version": "0.1.0",
    "private": true,
    "license": "MIT",
    "type": "module",
    "scripts": {
        "dev": "bun run generate:kana-stroke-data && vite dev",
        "build": "bun run generate:kana-stroke-data && bun run typecheck && vite build",
        "generate:kana-stroke-data": "bun run scripts/generate-kana-stroke-data.ts",
        "start": "vite preview",
        "analyze": "ANALYZE=1 bun run build",
        "knip": "knip",
        "knip:production": "knip --production",
        "typecheck": "tsc --noEmit",
        "lint": "oxlint .",
        "format": "oxfmt .",
        "format:check": "oxfmt --check .",
        "test": "playwright test",
        "test:ui": "playwright test --ui",
        "test:report": "playwright show-report"
    },
    "dependencies": {
        "@fontsource-variable/geist": "^5.3.0",
        "@fontsource-variable/geist-mono": "^5.3.0",
        "@radix-ui/react-dialog": "1.1.15",
        "@radix-ui/react-dropdown-menu": "2.1.16",
        "@radix-ui/react-label": "2.1.8",
        "@radix-ui/react-select": "2.2.6",
        "@radix-ui/react-separator": "1.1.8",
        "@radix-ui/react-slider": "1.3.6",
        "@radix-ui/react-slot": "1.2.4",
        "@radix-ui/react-tooltip": "1.2.8",
        "@tanstack/charts": "^0.14.0",
        "@tanstack/react-hotkeys": "^0.10.0",
        "@tanstack/react-router": "^1.170.27",
        "@tanstack/react-start": "^1.168.44",
        "class-variance-authority": "0.7.1",
        "clsx": "2.1.1",
        "cmdk": "^1.1.1",
        "embla-carousel-react": "8.6.0",
        "idb": "^8.0.3",
        "lucide-react": "1.7.0",
        "next-themes": "0.4.6",
        "radix-ui": "^1.4.3",
        "react": "19.2.3",
        "react-dom": "19.2.3",
        "sonner": "^2.0.7",
        "tailwind-merge": "3.4.0",
        "usehooks-ts": "3.1.1"
    },
    "devDependencies": {
        "@playwright/test": "1.62.1",
        "@tailwindcss/vite": "^4.3.3",
        "@tanstack/devtools-vite": "^0.8.3",
        "@tanstack/react-devtools": "^0.10.10",
        "@tanstack/react-router-devtools": "^1.167.1",
        "@types/node": "^26.2.0",
        "@types/react": "19.2.7",
        "@types/react-dom": "19.2.3",
        "@vitejs/plugin-react": "^6.0.5",
        "knip": "^6.32.2",
        "oxfmt": "0.63.0",
        "oxlint": "1.78.0",
        "oxlint-tsgolint": "7.0.2001",
        "rollup-plugin-visualizer": "^7.1.1",
        "tailwindcss": "4.1.18",
        "tw-animate-css": "1.4.0",
        "typescript": "7.0.2",
        "vite": "^8.2.1",
        "wrangler": "^4.122.0"
    }
}
